# Python
__pycache__/
*.py[cod]
*.so
.pytest_cache/

# Virtual environments
.venv/
venv/
build/
dist/
*.egg-info/

# IDE
.vscode/
.idea/
.DS_Store

# 运行缓存（引擎目录内生成；子模块方式挂载时避免弄脏引擎提交）
ocr_engines/
logs/
index/

# 视频/大产物不入库
*.mp4
*.mkv
*.avi
*_log.csv
*_output.csv

# Agent 工作区（会话记忆 / 中间态，非项目源码）
.workbuddy/
# Agent worktree：会话产出的完整仓库副本。实测 .claude/ 达 154 MB，
# 且让每次搜索多返回约 6 倍重复命中。搜索侧另由 .rgignore 单独控制。
.claude/
# 智能体会话残留：Zed/agent 的 plans 目录（会话 UUID 命名，非项目文档）。
# 实测曾入库一个 v5 调度计划——其前提（项目层 hybrid 调度）已由 C-05 判死，
# 且它要求新增两个注册表里不存在的环境旋钮，被当规范读会误导。与 .claude/ 同政策。
.zcode/
# 探针输出产物
tools/_probe_truth_env.json
tools/_int8_probe/
# 探针生成的拼图/裁图产物
tools/_slf_vis/
tools/_merge_vis/

# 外部只读审查报告（本地生成的一次性分析输入，非项目文档；
# 其结论已沉淀进 docs/PERFORMANCE.md 与 docs/DECISIONS.md）
PERFORMACE_REPORT.txt
gpu_kernels/
ocr_engines/*.engine

# bench run registry（append-only 本地证据，§8.6 N-4）
bench/

# 探针/基准运行日志与一次性调试 dump（run 产物，非源码；与 bench/ 同政策）
# 例：tools/_bench_mig*_*.log（22 个，零引用）、/_spy_{new,old}.json
tools/*.log
/_spy_*.json
